# Postgres connection string.
# Local dev:  postgresql://postgres:<password>@localhost:5432/pyramid?schema=public
# Neon (prod): postgresql://<user>:<pass>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pyramid?schema=public"

# Secret used to sign JWTs. Generate with: openssl rand -base64 32
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="30d"

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS="http://localhost:3000"

PORT=3001
