// Prisma schema for the Pyramid task management system.
//
// Modelling notes:
// - Statuses are rows, not an enum. The board design (screen 2) has an "add column"
//   affordance, so columns have to be data the user can extend at runtime.
// - Subtasks are Tasks with a parentId self-relation rather than a separate table:
//   screen 6 renders subtasks with the same columns as top-level tasks
//   (priority / members / due date), so they carry the same shape.
// - Members is many-to-many via TaskAssignee; the design shows avatar stacks.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 takes the connection URL from prisma.config.ts (for the CLI) and
// from the driver adapter passed to PrismaClient (at runtime), not from here.
datasource db {
  provider = "postgresql"
}

enum Priority {
  NO_PRIORITY
  URGENT
  HIGH
  MEDIUM
  LOW
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  username  String?
  title     String?
  avatarUrl String?
  isGuest   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   WorkspaceMember[]
  ownedProjects Project[]         @relation("ProjectLead")
  reportedTasks Task[]            @relation("TaskReporter")
  assignments   TaskAssignee[]
  comments      Comment[]
  activities    Activity[]

  @@index([isGuest, createdAt])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  WorkspaceMember[]
  projects Project[]
  statuses Status[]
  labels   Label[]
  teams    Team[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// A board column. Ordered, workspace-scoped, user-extendable.
model Status {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("#8b8b8b")
  position    Int
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([workspaceId, name])
  @@index([workspaceId, position])
}

model Label {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  color       String @default("#8b8b8b")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([workspaceId, name])
}

model Team {
  id          String @id @default(cuid())
  workspaceId String
  name        String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskTeam[]

  @@unique([workspaceId, name])
}

model Project {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  priority    Priority  @default(NO_PRIORITY)
  leadId      String?
  dueDate     DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      User?     @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@index([workspaceId, position])
}

model Task {
  id          String    @id @default(cuid())
  projectId   String?
  statusId    String
  parentId    String?
  title       String
  description String?
  priority    Priority  @default(NO_PRIORITY)
  startDate   DateTime?
  dueDate     DateTime?
  position    Int       @default(0)
  reporterId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status    Status     @relation(fields: [statusId], references: [id])
  parent    Task?      @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks  Task[]     @relation("Subtasks")
  reporter  User?      @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  assignees TaskAssignee[]
  labels    TaskLabel[]
  teams     TaskTeam[]
  comments  Comment[]
  activities Activity[]
  resources Resource[]

  @@index([statusId, position])
  @@index([projectId])
  @@index([parentId])
}

model TaskAssignee {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
}

model TaskTeam {
  taskId String
  teamId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([taskId, teamId])
}

// "Add document or link" row on the task detail screen.
model Resource {
  id        String   @id @default(cuid())
  taskId    String
  label     String
  url       String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  parentId  String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task    Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([taskId, createdAt])
  @@index([parentId])
}

// Feeds the "Updates" panel on the task detail screen.
model Activity {
  id        String   @id @default(cuid())
  taskId    String
  userId    String?
  type      String
  message   String
  createdAt DateTime @default(now())

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}
